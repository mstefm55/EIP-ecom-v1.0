# System-wide environment for EIP (API + dashboard)
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
CORS_ORIGIN_PUBLIC=http://localhost:5173,http://localhost:5174

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=eip
PG_POOL_MAX=10

# Security
COOKIE_SECRET=change_me
API_KEY_PEPPER=change_me
OTP_PEPPER=change_me
CSRF_PEPPER=change_me
BOOTSTRAP_TOKEN_PEPPER=change_me
TOTP_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
TOTP_ISSUER=EIP
REQUIRE_TRUSTED_DEVICE=false
ELECTRON_CHALLENGE_TTL_SEC=120
ELECTRON_DEVICE_REQUIRE_TRUSTED=true
SESSION_IDLE_TTL_MIN=120
REQUIRED_TENANT_AGREEMENTS=

# Feature flags
ENABLE_DEBUG_ROUTES=false
ENABLE_PUBLIC_DB_HEALTH=false
LOG_DEV_OTP=false
PUBLIC_TENANT_GUARD=true
ASSET_TOKEN_REQUIRED=true
ASSET_TOKEN_TTL_SEC=604800
INBOUND_RATE_LIMIT_MAX=120
INBOUND_RATE_LIMIT_WINDOW_SEC=60

# Translation provider (backend only)
TRANSLATION_PROVIDER_ENABLED=false
TRANSLATION_PROVIDER_CODE=libretranslate
TRANSLATION_PROVIDER_BASE_URL=http://localhost:5000
TRANSLATION_PROVIDER_API_KEY=
TRANSLATION_PROVIDER_API_REGION=
TRANSLATION_PROVIDER_MODEL=
TRANSLATION_PROVIDER_TIMEOUT_MS=15000
TRANSLATION_SOURCE_LANG=en
TRANSLATION_TARGET_LANGS=fr,ru,ar
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=

# FX sync (primary + fallback providers)
FX_SYNC_ENABLED=true
FX_SYNC_INTERVAL_MIN=1440
FX_SYNC_FRESHNESS_HOURS=24
FX_BASE_CURRENCY=USD
FX_PRIMARY_PROVIDER=openexchangerates
FX_FALLBACK_PROVIDER=ecb
FX_PROVIDER_PRIORITY=openexchangerates,ecb
FX_TIMEOUT_MS=12000
FX_OPENEXCHANGERATES_APP_ID=
FX_OPENEXCHANGERATES_CONNECTION_CODE=
FX_ECB_CONNECTION_CODE=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@eip-core.com
PASSWORD_RESET_URL_BASE=http://localhost:5173
PASSWORD_RESET_PEPPER=change_me
RECOVERY_TOKEN_URL_BASE=http://localhost:5173
RECOVERY_TOKEN_PEPPER=change_me
RECOVERY_TOKEN_TTL_MIN=30
ALLOW_RECOVERY_NO_TOTP=false

# Dashboard (Vite)
VITE_API_BASE_URL=http://localhost:4000
VITE_SESSION_IDLE_MIN=120
