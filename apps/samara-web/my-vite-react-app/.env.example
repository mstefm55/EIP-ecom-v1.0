# Public storefront display controls.
VITE_EIP_MATERIAL_TYPE=product
VITE_EIP_FEATURED_TAG=featured
VITE_EIP_DROP_TAG=drop
VITE_EIP_WORTH_TAG=worth
VITE_EIP_HERO_TAG=hero
VITE_EIP_HERO_MAX_SLIDES=5
VITE_EIP_PAGE_SIZE=12
VITE_EIP_REFRESH_MS=300000

# External EIP plug-and-play contract.
# Copy both values from the Samara tenant connection in Admin > Connections.
VITE_EIP_ENDPOINT=https://eip-ecom-v1.up.railway.app/api/public/commerce/<storefront_endpoint>
VITE_EIP_API_KEY=<connection_api_key>
