# Optional Google/Firebase helpers from the AI Studio reference app.
# Keep these empty unless this reference app is intentionally deployed with Google Drive features enabled.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional Gemini key if AI features are wired in later. Do not commit a real value.
VITE_GEMINI_API_KEY=

# Public URL if this reference app is previewed independently.
VITE_APP_URL=http://localhost:3000
