# Public storefront display controls.
VITE_EIP_MATERIAL_TYPE=product
VITE_EIP_FEATURED_TAG=featured
VITE_EIP_DROP_TAG=drop
VITE_EIP_WORTH_TAG=worth
VITE_EIP_HERO_TAG=hero
VITE_EIP_HERO_MAX_SLIDES=5
VITE_EIP_PAGE_SIZE=12
VITE_EIP_REFRESH_MS=300000

# External EIP gateway contract.
# These values come from the Samara tenant connection created in Admin > Connections.
VITE_EIP_GATEWAY_BASE_URL=https://eip-ecom-v1.up.railway.app
VITE_EIP_SUFFIX=<inbound_path_suffix>
VITE_EIP_CONNECTION_CODE=<connection_code>
VITE_EIP_EVENT_ID_HEADER=X-Event-Id
VITE_EIP_CLIENT_SOURCE=web-client
VITE_EIP_EXTERNAL_REF_PREFIX=web

# Optional: key created in Admin > Connections > API keys.
# Used only for public gateway bootstrap/manifest checks.
VITE_EIP_GATEWAY_API_KEY=<gateway_api_key_if_used>
VITE_EIP_GATEWAY_API_KEY_HEADER=X-API-Key

# Optional: only set when the connection profile's browser-facing public commerce
# verification mode explicitly requires an API-key-style header.
VITE_EIP_COMMERCE_VERIFICATION_KEY=
VITE_EIP_COMMERCE_VERIFICATION_HEADER=X-API-Key
